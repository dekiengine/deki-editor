# Formatting for the Deki editor.
#
# This describes the style the codebase ALREADY uses; it was derived by
# measuring, not chosen. Allman braces outnumber K&R 5515 to 673, indentation is
# 4 spaces with no 2-space code anywhere, and `T* p` outnumbers `T *p` 1567 to
# 13. Applying this should be close to a no-op on existing files - if it is not,
# the setting is wrong, not the code.
#
# Naming is a separate matter and clang-format does not enforce it. See the
# Naming Convention section of CLAUDE.md.
Language: Cpp
BasedOnStyle: LLVM

# Braces on their own line, the dominant style here by a wide margin.
BreakBeforeBraces: Allman

IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: None

# 0 = never reflow a line the author already fitted. Adopting a column limit on
# an existing codebase rewraps a third of it for no readability gain and buries
# every future diff; the authors' own line breaks are already sensible here.
ColumnLimit: 0

PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# Trivial accessors are written inline throughout (GetId, IsActive, ...) and
# should stay that way; anything longer gets expanded.
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
# `case X: return "y";` on one line is used heavily in the type-mapping
# switches; splitting them makes those tables far harder to read.
AllowShortCaseLabelsOnASingleLine: true

# Include order here is deliberate: a file's own header first, then project
# headers, then engine, then third-party. Sorting would reorder that and produce
# a large diff for no benefit - and in a few places the order is load-bearing.
SortIncludes: Never

# Likewise leave using-declarations where the author put them; sorting them
# reorders related lines apart for no benefit.
SortUsingDeclarations: Never

# Existing code aligns neither; leaving these off avoids reflowing whole blocks.
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignTrailingComments: true

SpaceAfterCStyleCast: false
SpacesBeforeTrailingComments: 2
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

# Respect the author's braced-list layout instead of repacking it. Several
# tables here are laid out one entry per line on purpose.
Cpp11BracedListStyle: false
BinPackArguments: true
BinPackParameters: true
IndentCaseLabels: true
